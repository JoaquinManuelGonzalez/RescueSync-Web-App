# Plantilla de variables de entorno de RescueSync.
# Copiar este archivo a ".env" (que ya esta ignorado por git) y completar los valores reales.
# Las variables marcadas con (*) son OBLIGATORIAS y no tienen valor por defecto: si falta alguna,
# la aplicacion debe fallar al arrancar (fail fast). Ver docs/contratos/configuracion.md.

# =============================================================================
# Aplicacion
# =============================================================================

# Entorno de ejecucion: "local" | "evaluacion" | "produccion".
APP_ENV=local

# (*) Clave secreta de Flask para firmar la sesion y los tokens CSRF. Generar una distinta por
# entorno; nunca reutilizar la misma clave entre local y evaluacion.
SECRET_KEY=

# Puerto en el que escucha la aplicacion dentro del contenedor, y en el que docker-compose.yml
# la publica en el host. Con el valor por defecto la app queda en http://localhost:5000.
APP_PORT=5000

# Nivel minimo de log: "DEBUG" | "INFO" | "WARN" | "ERROR". Ver docs/contratos/logging.md.
LOG_LEVEL=INFO


# =============================================================================
# Base de datos (PostgreSQL 18 en contenedor)
# =============================================================================

# Host del servicio de base de datos segun docker-compose.yml (nombre del servicio, no localhost).
POSTGRES_HOST=db

# Puerto de PostgreSQL dentro de la red de contenedores.
POSTGRES_PORT=5432

# Puerto del HOST en el que docker-compose.yml publica PostgreSQL. Cambiarlo si en tu maquina
# ya hay otro PostgreSQL ocupando el 5432 (por ejemplo POSTGRES_HOST_PORT=5433). No afecta a
# DATABASE_URL: la aplicacion se conecta por la red interna, no por el puerto del host.
POSTGRES_HOST_PORT=5432

# Nombre de la base de datos.
POSTGRES_DB=rescuesync

# (*) Usuario de PostgreSQL.
POSTGRES_USER=

# (*) Contrasena de PostgreSQL.
POSTGRES_PASSWORD=

# (*) Cadena de conexion completa que usa SQLAlchemy. Debe ser consistente con las cuatro
# variables POSTGRES_* de arriba, por ejemplo:
# postgresql+psycopg://usuario:contrasena@db:5432/rescuesync
DATABASE_URL=


# =============================================================================
# Bonita (motor de procesos)
# =============================================================================

# (*) URL base de la REST API de Bonita, por ejemplo http://bonita:8080/bonita.
BONITA_BASE_URL=

# (*) Usuario tecnico con el que la aplicacion abre sesion contra Bonita.
BONITA_USER=

# (*) Contrasena del usuario tecnico de Bonita.
BONITA_PASSWORD=

# Nombre del proceso BPMN a instanciar al dar de alta una emergencia.
BONITA_PROCESO_NOMBRE=GestionDeEmergencia

# Version del proceso BPMN publicado en Bonita.
BONITA_PROCESO_VERSION=1.0

# Timeout, en segundos, para las llamadas salientes hacia Bonita (timeout de lectura).
BONITA_TIMEOUT_S=10

# (*) Token de servicio que Bonita debe enviar para autenticarse contra el endpoint de ofertas
# consolidadas (integracion 4, ver docs/arquitectura/componentes.md). No es una sesion de
# usuario: es un secreto compartido exclusivo de esa llamada.
BONITA_CALLBACK_TOKEN=


# =============================================================================
# API Nacional
# =============================================================================

# (*) URL base de la API Nacional, por ejemplo https://api-nacional.ejemplo.gob.ar.
API_NACIONAL_BASE_URL=

# (*) Client ID para la autenticacion JWT contra la API Nacional.
API_NACIONAL_CLIENT_ID=

# (*) Client secret para la autenticacion JWT contra la API Nacional.
API_NACIONAL_CLIENT_SECRET=

# Timeout, en segundos, para las llamadas salientes hacia la API Nacional (timeout de lectura).
API_NACIONAL_TIMEOUT_S=10

# Cantidad de reintentos ante 5xx, timeout o error de red (no cuenta el intento original).
API_NACIONAL_REINTENTOS=2

# Base del backoff exponencial entre reintentos, en milisegundos.
API_NACIONAL_BACKOFF_MS=500


# =============================================================================
# Control de acceso (identidad, sesion y RBAC)
# =============================================================================
# Ver docs/contratos/autorizacion.md.

# Minutos de inactividad tras los cuales la sesion expira y hay que volver a ingresar.
# Es el requisito no funcional de la epica de identidad y se verifica del lado del servidor.
SESION_MINUTOS_INACTIVIDAD=30

# Intentos de ingreso fallidos consecutivos antes de bloquear temporalmente la cuenta.
LOGIN_MAX_INTENTOS=5

# Minutos que dura el bloqueo temporal de la cuenta tras agotar los intentos.
LOGIN_BLOQUEO_MINUTOS=15

# Longitud minima exigida a las contrasenas al crearlas o cambiarlas.
CONTRASENA_LONGITUD_MINIMA=10
